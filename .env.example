# BizMind AI Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application Settings
PROJECT_NAME="BizMind AI"
VERSION="1.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"
CORS_ORIGINS=["*"]

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# File Storage
UPLOAD_DIR="uploads"

# Optional External Integrations (AI / Database)
# OPENAI_API_KEY=your_openai_api_key_here
# DATABASE_URL=postgresql://user:password@localhost:5432/bizmind
